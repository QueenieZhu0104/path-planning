# Copy this file to .dev.vars for local development. Do not commit your actual key.
# Choose ONE AI provider.
OPENAI_API_KEY="replace-with-your-own-secret"
OPENAI_MODEL="gpt-6-luna"
# Compatibility override used by Path Intelligence, route evidence, and activity evidence.
OPENAI_CONSULTANT_MODEL="gpt-6-luna"
# Optional: enables explicit live=1 U.S. institution metadata searches.
# Obtain a key from api.data.gov; never expose this value in public/index.html.
COLLEGE_SCORECARD_API_KEY="replace-with-your-own-data-gov-secret"
